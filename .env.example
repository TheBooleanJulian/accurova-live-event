# --- Core ---
# Path to the SQLite database file. Relative paths are resolved from the repo root.
DB_PATH=./data/live_event.db

# Directory where uploaded event thumbnails are stored, served at /uploads/*.
# Should live on the same persistent volume as DB_PATH so images survive redeploys.
UPLOADS_DIR=./data/uploads

# Secret used to sign the admin session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-long-random-string

# Single-operator admin password (plain value here is hashed on first run — see README).
ADMIN_PASSWORD=change-me

# Base URL of this deployment, used to build absolute links in notification emails.
PUBLIC_BASE_URL=https://live-event.accurova.com

# --- Contact / outbound links (public page) ---
# Every "Message on WhatsApp" / "Book Consultation" CTA site-wide links here.
WHATSAPP_URL=https://wa.link/6y9sbx
# Shown as button text ("Message us at ...") — display-only, doesn't affect WHATSAPP_URL.
WHATSAPP_DISPLAY_NUMBER=+65 9856 6543
LINKEDIN_URL=https://www.linkedin.com/in/juliancheungjunyan/
# Not currently linked anywhere (company LinkedIn button is hidden), kept for future use.
LINKEDIN_COMPANY_URL=https://www.linkedin.com/company/accurova/
PORTFOLIO_URL=https://accurova.com/portfolio
GOOGLE_REVIEWS_URL=https://maps.app.goo.gl/JzfsHqPG3uGUjCFB6
SME_AWARD_URL=https://www.instagram.com/p/DVtb4MpD5HH/
# Name shown on the "save to contacts" button; used as the vCard FN and .vcf filename.
CONTACT_NAME=Julian Cheung (Photographer Accurova)

# --- Email notifications (choose ONE provider) ---
# EMAIL_PROVIDER = "resend" | "postmark" | "smtp" | "none"
EMAIL_PROVIDER=resend
EMAIL_FROM="Accurova <hello@accurova.com>"

# Resend (https://resend.com)
RESEND_API_KEY=

# Postmark (https://postmarkapp.com)
POSTMARK_SERVER_TOKEN=

# Plain SMTP (used if EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Rate limiting ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=5

# --- App ---
PORT=8000
ENV=development
